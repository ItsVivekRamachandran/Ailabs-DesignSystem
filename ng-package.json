{
  "$schema": "./node_modules/ng-packagr/ng-package.schema.json",
  "dest": "./dist/ailabs-design-system",
  "deleteDestPath": true,
  "assets": [
    {
      "glob": "**/*.css",
      "input": "src/design-system",
      "output": "styles"
    },
    {
      "glob": "**/*",
      "input": "schematics",
      "output": "schematics"
    },
    {
      "glob": "**/*",
      "input": "src/assets/icons/material",
      "output": "icons/material"
    }
  ],
  "lib": {
    "entryFile": "src/public-api.ts"
  }
}
